config SHIELD_RIGHT_TRACKPOINT_KEYPOINT
    def_bool $(shields_list_contains,right_trackpoint_keypoint)


menu "TrackPoint Advanced Settings"

config TRACKPOINT_POINTER_ACCEL
    bool "Enable velocity-based pointer acceleration"
    default y
    help
      Lenovo-style acceleration: output gain follows how hard/fast the
      TrackPoint is pushed. Light touch = slow precise movement, firm
      push = fast travel. The gain curve is min..max, reaching max at the
      configured input speed.

config TRACKPOINT_ACCEL_MIN_PERCENT
    int "Pointer acceleration minimum gain (Percentage, 60 = 0.6x)"
    default 62
    help
      Gain applied to the slowest movements (precise end of the curve).
      Calibrated 2026-09-30 from native ThinkPad trace: host ballistics
      give ~0.31 px/count at light touch.

config TRACKPOINT_ACCEL_MAX_PERCENT
    int "Pointer acceleration maximum gain (Percentage, 260 = 2.6x)"
    default 230
    help
      Gain applied at and above the configured maximum input speed.
      Calibrated 2026-09-30 from native trace (170), raised to 230 after
      user testing: firm pushes need more top-end speed on this host.

config TRACKPOINT_ACCEL_VMAX_X10
    int "Input speed where max gain is reached (counts/ms, times 10)"
    default 45
    help
      TrackPoint input speed (counts per millisecond, x10) at which the
      acceleration curve saturates. Calibrated 2026-09-30: 45 = 4.5 c/ms.

config TRACKPOINT_ACCEL_POW_X10
    int "Acceleration curve steepness (exponent, times 10)"
    default 9
    help
      Shape of the curve between min and max gain. Calibrated
      2026-09-30 from native trace fit (nearly linear).

config TRACKPOINT_SCROLL_X_DIR
    int "Scroll X direction multiplier (1 for normal, -1 for inverted)"
    default 1

config TRACKPOINT_SCROLL_Y_DIR
    int "Scroll Y direction multiplier (1 for normal, -1 for inverted)"
    default 1

config TRACKPOINT_SCROLL_DEADZONE
    int "Scroll deadzone"
    default 2
    help
      Deadzone to filter out slight hand tremors.

config TRACKPOINT_SCROLL_INPUT_MAX
    int "Scroll input max"
    default 128

config TRACKPOINT_SCROLL_DIVISOR_SLOW
    int "Scroll divisor slow (Fine-grained control)"
    default 60

config TRACKPOINT_SCROLL_DIVISOR_FAST
    int "Scroll divisor fast (Max speed limit)"
    default 8

config TRACKPOINT_DOMINANT_NUMERATOR
    int "Dominant axis numerator for accidental touch prevention"
    default 3

config TRACKPOINT_DOMINANT_DENOMINATOR
    int "Dominant axis denominator for accidental touch prevention"
    default 2

config TRACKPOINT_MOUSE_BASE_SPEED_PERCENT
    int "Mouse base speed (Percentage, 50 = 0.5)"
    default 50

endmenu